{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Proprietary Dataset Schema",
  "description": "Schema for future dataset candidates captured post-deployment.",
  "type": "object",
  "properties": {
    "productId": {
      "type": "string",
      "description": "Unique identifier for the product group"
    },
    "imageId": {
      "type": "string",
      "description": "Unique identifier for this specific image"
    },
    "view": {
      "type": "string",
      "enum": ["front", "back", "ingredients", "nutrition", "other"],
      "description": "The specific panel or view of the image"
    },
    "sourceType": {
      "type": "string",
      "enum": ["user_captured", "admin_captured", "imported"],
      "description": "Origin of the image"
    },
    "ownership": {
      "type": "string",
      "enum": ["project_owned", "external"],
      "description": "Ownership rights of the image"
    },
    "captureTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "captureDevice": {
      "type": "string"
    },
    "productName": {
      "type": "string"
    },
    "brandName": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "barcode": {
      "type": "string"
    },
    "countryOfOrigin": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "annotationStatus": {
      "type": "string",
      "enum": ["pending", "annotated", "validated"],
      "default": "pending"
    },
    "annotationVersion": {
      "type": "string"
    },
    "datasetSplit": {
      "type": "string",
      "enum": ["train", "validation", "test", "baseline_integration_dataset", "unassigned"],
      "default": "unassigned"
    },
    "trainingStatus": {
      "type": "string",
      "enum": ["candidate", "in_training", "trained", "rejected"],
      "default": "candidate"
    },
    "trainingEligible": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "productId",
    "imageId",
    "view",
    "sourceType",
    "ownership",
    "annotationStatus",
    "trainingEligible"
  ]
}
