# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>

# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Authentication
JWT_SECRET=<your-super-secret-jwt-key>
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-immediately

# Cloudinary (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# Python OCR service (FastAPI)
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_API_KEY=<your-ai-service-secret>

# AI Chat — Gemini API Free Tier; optional; when not set, the assistant gracefully reports "not configured"
AI_CHAT_PROVIDER=gemini
AI_CHAT_MODEL=gemini-3.5-flash-lite
AI_CHAT_API_KEY=<your-gemini-api-key>